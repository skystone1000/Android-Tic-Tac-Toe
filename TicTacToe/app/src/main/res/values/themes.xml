<resources>
    <!-- Base theme for a Compose app: no action bar, transparent system bars
         for edge-to-edge. All real theming is done in Compose (TicTacTheme). -->
    <style name="Theme.TicTacToe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
